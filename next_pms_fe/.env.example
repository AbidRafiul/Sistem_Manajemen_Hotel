# ==============================================================================
# Next.js PMS Frontend - Environment Variables Example
# Duplicate this file to .env and fill with appropriate values for your environment.
# NEVER commit the actual .env file with secrets into version control!
# ==============================================================================

NEXT_PUBLIC_APP_TZ=Asia/Jakarta
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000/

# NextAuth & Frontend Secrets (MANDATORY: Minimum 32 chars in production, MUST be DIFFERENT from BE secrets!)
NEXTAUTH_SECRET=random_frontend_nextauth_secret_minimum_32_chars
TOKEN_SECRET=random_frontend_token_secret_minimum_32_characters

# Cryptographic Keys (MUST match backend express_pms_be values)
USER_KEY=random_secure_user_key_32_characters_minimum
USER_PAS_KEY=random_secure_user_pas_key
USER_SECRET=random_secure_user_secret_32_characters_min

# Backend API Configuration
API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_URL_API=http://localhost:8000/api/v1
ALLOWED_ORIGIN=http://127.0.0.1:3000

# Next.js BFF Interceptor Paths
NEXT_PUBLIC_API_DIR_PATH=/api/interceptor
NEXT_PUBLIC_API_DIR_FORMDATA_PATH=/api/interceptor_formdata
NEXT_PUBLIC_API_DIR_DOWNLOAD_PATH=/api/interceptor_download
NEXT_PUBLIC_API_DIR_PATH_NO_AUTH=/api/auth/no_auth
PUBLIC_ASSET_ORG=http://127.0.0.1:8000
