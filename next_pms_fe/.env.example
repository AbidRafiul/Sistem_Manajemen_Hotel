# ==============================================================================
# Next.js PMS Frontend - Environment Variables Example
# Duplicate this file to .env and fill with appropriate values for your environment.
# NEVER commit the actual .env file with secrets into version control!
# ==============================================================================

NEXT_PUBLIC_APP_TZ=Asia/Jakarta
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_minimum_32_characters_here
TOKEN_SECRET=your_token_secret_here

# Cryptographic Keys (MUST match backend express_pms_be values)
USER_KEY=your_user_key_minimum_16_characters_here
USER_PAS_KEY=your_user_pas_key_min_16_characters_here
USER_SECRET=your_jwt_user_secret_minimum_32_characters_long_here

# Backend API Configuration
API_URL=http://localhost:8000
NEXT_PUBLIC_URL_API=http://localhost:8000
ALLOWED_ORIGIN=http://localhost:3000

# Next.js BFF Interceptor Paths
NEXT_PUBLIC_API_DIR_PATH=/api/interceptor
NEXT_PUBLIC_API_DIR_FORMDATA_PATH=/api/interceptor_formdata
NEXT_PUBLIC_API_DIR_DOWNLOAD_PATH=/api/interceptor_download
NEXT_PUBLIC_API_DIR_PATH_NO_AUTH=/api/interceptor_no_auth
PUBLIC_ASSET_ORG=http://localhost:8000
