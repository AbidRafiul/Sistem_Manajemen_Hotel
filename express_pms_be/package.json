{
  "name": "dashboard_be",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --legacy-watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=app.test.js --testPathIgnorePatterns=integration.test.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --testPathPattern=integration.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "knex seed:run",
    "seed:all": "node scripts/run_all_seeds.js",
    "seed:migration": "knex seed:run --specific=migration_batch3_seeder.js",
    "seed:master": "knex seed:run --specific=master_data_seeder.js",
    "seed:nav": "knex seed:run --specific=navigation_master_setup.js",
    "db:setup": "node scripts/run_all_seeds.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.9.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jose": "^6.0.8",
    "knex": "^3.1.0",
    "minio": "^8.0.5",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.9.6",
    "supertest": "^7.1.0"
  }
}
