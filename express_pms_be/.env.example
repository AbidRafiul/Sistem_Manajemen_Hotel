# ==============================================================================
# Express PMS Backend - Environment Variables Example
# Duplicate this file to .env and fill with appropriate values for your environment.
# NEVER commit the actual .env file with secrets into version control!
# ==============================================================================

# Application Configuration
NODE_ENV=development
APP_PORT=8000
APP_SERVER=http://127.0.0.1
APP_PREMISE=cloud
APP_TZ=Asia/Jakarta
APP_DEBUG=true

# Allowed Origins for CORS (comma-separated, without trailing slash)
ORIGIN=http://localhost:3000

# File Upload / Assets Path
ASSETS_PATH=http://localhost:3000/api/assets

# Database Configuration (Knex.js MySQL connection)
DB_DBMS=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=hotel_pms

# Security Keys & Secrets (MANDATORY: Minimum 32 characters in production)
# USER_KEY: Random secret key (min 32 characters in production)
USER_KEY=random_secure_user_key_32_characters_minimum
# USER_PAS_KEY: Retained per template standard (must be non-empty)
USER_PAS_KEY=random_secure_user_pas_key
# USER_SECRET: JWT signing key & password HMAC secret (min 32 characters in production)
USER_SECRET=random_secure_user_secret_32_characters_min

# MinIO / S3 Object Storage (Optional for local development)
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
