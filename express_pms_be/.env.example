# ==============================================================================
# Express PMS Backend - Environment Variables Example
# Duplicate this file to .env and fill with appropriate values for your environment.
# NEVER commit the actual .env file with secrets into version control!
# ==============================================================================

# Application Configuration
NODE_ENV=development
APP_PORT=8000
APP_SERVER=http://localhost:8000
APP_PREMISE=cloud
APP_TZ=Asia/Jakarta
APP_DEBUG=false
DEV_AUTH_BYPASS=false

# Allowed Origins for CORS (comma-separated, without trailing slash)
ORIGIN=http://localhost:3000

# File Upload / Assets Path
ASSETS_PATH=public/uploads

# Database Configuration (Knex.js MySQL connection)
DB_DBMS=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password_here
DB_DATABASE=sistem_manajemen_hotel

# Security Keys & Secrets (MANDATORY: Minimum length enforced by env_check.js)
# USER_KEY: Minimum 16 characters
USER_KEY=your_user_key_minimum_16_characters_here
# USER_PAS_KEY: Minimum 16 characters
USER_PAS_KEY=your_user_pas_key_min_16_characters_here
# USER_SECRET: Minimum 32 characters (JWT sign/verify secret)
USER_SECRET=your_jwt_user_secret_minimum_32_characters_long_here

# MinIO / S3 Object Storage (Optional for local development)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
